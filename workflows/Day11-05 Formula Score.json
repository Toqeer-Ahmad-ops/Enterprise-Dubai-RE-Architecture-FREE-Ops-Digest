    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Code Build Query').item.json;\nconst rag = $input.item.json;\nconst relevance = lead.current_score || 50;\nconst confidence = Math.round((rag.similarity || 0.75) * 100);\nconst finalScore = Math.round(relevance*0.6 + confidence*0.4);\nlet band = finalScore >= 80 ? 'Hot' : finalScore >= 50 ? 'Warm' : 'Cold';\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    score: finalScore,\n    band: band,\n    reason: `Formula: ${relevance}*0.6 + ${confidence}*0.4 | RAG ${rag.filename} sim ${confidence}`,\n    model: 'formula-rag-v1'\n  }\n};"
      },
