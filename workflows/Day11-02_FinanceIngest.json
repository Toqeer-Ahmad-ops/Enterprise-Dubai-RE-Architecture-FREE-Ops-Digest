    {
      "parameters": {
        "jsCode": "// Day11-02 FIXED 2.43.5 - No for...of, index loop only\nconst CHUNK_SIZE = 2000;\nconst results = [];\n\n// 2.43.5 compatible get items\nlet inputItems = [];\ntry {\n  if ($input && $input.all) {\n    inputItems = typeof $input.all === 'function' ? $input.all() : $input.all;\n  }\n} catch (e) {}\nif (!inputItems || inputItems.length === 0) {\n  try { inputItems = $items(\"IF Has Docs\", 0, 0) || []; } catch(e) {}\n}\n\nfor (let j = 0; j < inputItems.length; j++) {\n  const doc = inputItems[j].json;\n  if (!doc || !doc.content) continue;\n  let count = 0;\n  for (let i = 0; i < doc.content.length; i += CHUNK_SIZE) {\n    results.push({\n      json: {\n        filename: doc.filename || 'unknown.pdf',\n        content: doc.content.slice(i, i + CHUNK_SIZE),\n        chunk_index: count++,\n        parent_id: doc.id || null\n      }\n    });\n  }\n}\nreturn results;"
      },
