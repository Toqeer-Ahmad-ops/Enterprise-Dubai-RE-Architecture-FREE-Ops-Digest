    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst msg = ((item.last_message || '') + ' ' + (item.intent || '') + ' ' + (item.source || '')).toLowerCase();\nconst loc = (item.location || '').toLowerCase();\n\nlet score = 30;\nlet reason = 'General inquiry';\n\nif (/urgent|asap|today|now|ready/.test(msg)) { \n  score += 30; \n  reason = 'Urgent intent'; \n}\nif (/buy|cash|invest|budget/.test(msg)) { \n  score += 20; \n  reason += ' + buying intent'; \n}\nif (/marina|palm|downtown|bay|2br|3br/.test(msg + ' ' + loc)) { \n  score += 15; \n  reason += ' + premium location'; \n}\n\nscore = Math.min(score, 95);\n\nreturn {\n  json: {\n    ...item,\n    regex_score: score,\n    regex_reason: reason\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
