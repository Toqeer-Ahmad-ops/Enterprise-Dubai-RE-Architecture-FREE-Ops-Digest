        "jsonBody": "={\n  \"contents\": [{\"parts\": [{\"text\": \"Score 0-100 this Dubai lead: Name={{ $json.name }} Location={{ $json.location }} Source={{ $json.source }} Regex={{ $json.regex_score }}. Return ONLY JSON {\\\"score\\\":80,\\\"reason\\\":\\\"...\\\"}\"}]}]\n}",
