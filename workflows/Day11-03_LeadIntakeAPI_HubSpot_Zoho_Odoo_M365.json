        "jsCode": "// FREE - matches your real leads table\nconst body = $input.item.json.body || $input.item.json;\nconst headers = $input.item.json.headers || {};\n\nconst EXPECTED = 'dxb_prod_toqeer_2026_free';\nconst incoming = headers['x-api-key'] || headers['X-Api-Key'] || '';\n\nif (incoming && incoming !== EXPECTED) {\n  throw new Error('Invalid x-api-key');\n}\n\nfunction cleanPhone(p){ return (p||'').replace(/[^+0-9]/g,'').slice(0,20); }\nconst phoneClean = cleanPhone(body.phone);\n\nreturn {\n  json: {\n    name: (body.full_name || body.name || '').trim(),\n    phone: phoneClean,\n    email: (body.email || '').toLowerCase().trim(),\n    budget_max: body.budget_max ? Number(body.budget_max) : null,\n    location: (body.location || '').trim(),\n    intent: (body.purpose || body.intent || body.purpose || '').trim().toLowerCase(), // purpose -> intent\n    timeline: (body.timeline || '').trim(),\n    last_message: (body.message || body.last_message || '').trim(),\n    source: body.source || 'IntakeAPI',\n    status: 'new',\n    qualification_status: 'new',\n    idempotency_key: phoneClean + '_' + Date.now(), // avoids unique clash\n    lead_score: 0\n  }\n};"
      },
